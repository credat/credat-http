{
	"name": "@credat/http",
	"version": "0.1.0-alpha.1",
	"publishConfig": {
		"access": "public"
	},
	"description": "Drop-in Credat protection for HTTP APIs — verify agent identity, delegated permissions, and scopes on any service.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./express": {
			"import": {
				"types": "./dist/express.d.ts",
				"default": "./dist/express.js"
			},
			"require": {
				"types": "./dist/express.d.cts",
				"default": "./dist/express.cjs"
			}
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"credat",
		"ai-agents",
		"trust",
		"delegation",
		"authentication",
		"http",
		"express",
		"middleware"
	],
	"author": "Maxime Mansiet",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/credat/credat-http.git"
	},
	"homepage": "https://github.com/credat/credat-http#readme",
	"bugs": {
		"url": "https://github.com/credat/credat-http/issues"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"peerDependencies": {
		"@credat/sdk": "^0.3.0-alpha.1",
		"express": "^4.18.0 || ^5.0.0"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@credat/sdk": "^0.3.0-alpha.1",
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"express": "^5.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
